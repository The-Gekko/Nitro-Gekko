# ---------------------------------------------------------------------------
#  Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------------------
#  Modulo del kernel (rgb/)
#
#  El modulo compilado es un binario de ~900 KB atado a UNA version exacta de
#  kernel (vermagic 7.2.3-zen1-2-zen): no sirve para nadie mas y no debe ir al
#  repositorio.  El fuente parcheado (rgb/src/linuwu_sense.c) SI se conserva.
#
#  OJO con la ruta: el Makefile declara `obj-m := src/linuwu_sense.o`, asi que
#  kbuild deja el .ko y toda la basura de compilacion en rgb/src/, NO en rgb/.
#  Se ignoran las dos ubicaciones para que valga tanto compilando en el arbol
#  como compilando desde /usr/src via DKMS.
# ---------------------------------------------------------------------------
*.ko
*.o
*.mod
*.mod.c
*.mod.o
.*.cmd
Module.symvers
modules.order
.tmp_versions/
*.symvers
*.order

# ---------------------------------------------------------------------------
#  Temporales, copias de seguridad y basura del editor / escritorio
# ---------------------------------------------------------------------------
*.bak
*.orig
*.rej
*.swp
*.swo
*~
*.tmp
*.log
.idea/
.vscode/
.directory
.DS_Store
